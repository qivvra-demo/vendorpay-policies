{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "qivvra/v1/policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "id", "title", "version", "status", "authority", "owner", "severity", "applies_to", "rule", "obligations", "on_violated", "on_insufficient", "exceptions", "effective_from", "review_by"],
  "properties": {
    "apiVersion": { "const": "qivvra/v1" },
    "kind": { "const": "Policy" },
    "id": { "type": "string", "pattern": "^(FIN|SEC|CMP|PLT)-\\d{3}$" },
    "title": { "type": "string", "minLength": 5 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["draft", "approved", "retired"] },
    "authority": { "enum": ["finance", "security", "compliance", "platform"] },
    "owner": { "type": "string", "pattern": "^@[\\w.-]+/[\\w.-]+$" },
    "severity": { "enum": ["critical", "high", "medium"] },
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "components": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "always": { "const": true }
      },
      "oneOf": [{ "required": ["components"] }, { "required": ["always"] }]
    },
    "rule": { "type": "string", "minLength": 20 },
    "rationale": { "type": "string" },
    "obligations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string", "minLength": 10 },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verifier", "check"],
            "properties": { "verifier": { "type": "string", "pattern": "^V\\d+$" }, "check": { "type": "string" } }
          }
        }
      }
    },
    "on_violated": { "const": "block" },
    "on_insufficient": { "enum": ["block", "warn"] },
    "exceptions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed"],
      "properties": {
        "allowed": { "type": "boolean" },
        "approver_authority": { "enum": ["finance", "security", "compliance", "platform"] },
        "max_days": { "type": "integer", "minimum": 1, "maximum": 90 },
        "requires": { "type": "array", "items": { "enum": ["compensating_control", "expiry"] } }
      },
      "if": { "properties": { "allowed": { "const": true } } },
      "then": { "required": ["approver_authority", "max_days"] }
    },
    "effective_from": { "type": "string", "format": "date" },
    "review_by": { "type": "string", "format": "date" }
  }
}
